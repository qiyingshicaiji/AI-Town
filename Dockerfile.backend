FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
# Patch: 新版 qdrant-client CollectionInfo 无 vectors_count 属性
RUN python -c "import hello_agents.memory.storage.qdrant_store as m; import re; p=m.__file__; c=open(p).read(); c=c.replace('collection_info.vectors_count','collection_info.points_count'); open(p,'w').write(c); print('Patched:', p)"

# Copy backend code
COPY backend/ .

# Create data directories
RUN mkdir -p /app/timeline_data /app/memory_data /app/logs

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

EXPOSE 8000

CMD ["python", "main.py"]
