# Express BFF + Vue 3 CDN 静态前端
FROM node:20-alpine

WORKDIR /app

# BFF dependencies
COPY bff/package.json bff/package-lock.json* ./
RUN npm ci --production=false

# BFF source
COPY bff/ ./

# Build TypeScript
RUN npm run build

# Vue 3 CDN 静态前端（无需构建）
COPY frontend/ ./frontend/

EXPOSE 3000

CMD ["node", "dist/index.js"]
